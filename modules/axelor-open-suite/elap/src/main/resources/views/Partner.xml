<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

    <grid name="partner-resident-grid" title="Persons" model="com.axelor.apps.base.db.Partner">
        <field name="name" title="Full name"/>
        <field name="firstName"/>
        <field name="lastName"/>
        <field name="externalId"/>
        <field name="partnerType" title="Person type"/>
        <field name="status"/>
    </grid>

    <form name="partner-resident-form" title="Person" model="com.axelor.apps.base.db.Partner">
        <panel>
            <field name="name" title="Full name"/>
            <field name="firstName"/>
            <field name="lastName"/>
            <field name="externalId"/>
            <field name="partnerType"/>
            <field name="status"/>
            <field name="cardNumber"/>
            <field name="pinCode"/>
            <field name="email"/>
            <field name="phone"/>
            <field name="version"/>
            <field name="updatedAt"/>
            <button name="syncPartner" title="Sync person" onClick="action-partner-add-access-rights"/>
            <button name="showSyncStatus" title="Show sync status" onClick="action-partner-method-show-sync-status"/>
        </panel>
        <panel-related field="accessCredentials" title="Person zone access">
            <field name="device"/>
            <field name="accessZone"/>
            <field name="accessRights"/>
            <field name="validFrom"/>
            <field name="validTo"/>
        </panel-related>
    </form>

    <action-method name="action-partner-add-access-rights">
        <call class="com.axelor.web.PartnerController" method="partnerSaveDevice"/>
    </action-method>

    <action-method name="action-partner-method-show-sync-status">
        <call class="com.axelor.web.PartnerController" method="showSyncStatus"/>
    </action-method>

</object-views>
