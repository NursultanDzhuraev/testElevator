<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

    <grid name="building-grid" title="Building" model="com.axelor.apps.erp.db.Building">
        <field name="name" title="Name of the RC"/>
        <field name="address"/>
        <field name="entrance" title="Entrances"/>
    </grid>
    <grid name="building-apartment-grid" title="Building" model="com.axelor.apps.erp.db.Building">
        <field name="name"/>
    </grid>
    <form name="building-apartment-form" title="Building" model="com.axelor.apps.erp.db.Building">
        <panel-related field="entrance" title="Entrances" editable="false"
                       edit-window="popup">
            <field name="entranceNumber"/>
        </panel-related>
    </form>

    <form name="building-form" title="Building" model="com.axelor.apps.erp.db.Building" onLoad="action-building-statistics">
        <panel colSpan="6">
            <field name="name" title="Name of the RC"/>
            <field name="address" onChange="action-building-method-address, action-building-attrs"/>
            <field name="$showPossible" type="boolean" hidden="true" showTitle="false" colSpan="12"/>
            <field name="latitude" hidden="true"/>
            <field name="longitude" hidden="true"/>
            <panel-related field="geoResult" title="All address" showIf="$showPossible" editable="false"
                           canNew="false" canEdit="false" canRemove="false"
                           onChange="action-building-apply-pending-geo" colSpan="12">
                <field name="displayName" title="Address"/>
                <field name="houseNumber"/>
                <button name="btnSelectThis" title="Choice" icon="fa-check-circle"
                        onClick="action-building-apply-selected-geo"/>
            </panel-related>
        </panel>
        <panel-related field="entrance" title="Entrances" editable="true" canNew="true"
                       canEdit="true" grid-view="entrance-apartment-grid" edit-window="popup">
            <field name="entranceNumber"/>
        </panel-related>
        <panel-related field="device" title="Device" readonly="true"
                       showIf="device &amp;&amp; device.length &gt; 0">
            <field name="name" title="Name"/>
            <field name="ip" title="Ip address"/>
            <field name="deviceType" title="Device Type"/>
            <field name="isActive" title="Is Active"/>
            <field name="entrance"/>
        </panel-related>
        <panel name="erp"  hidden="false" colSpan="12">
            <panel-dashlet action="action-erp-building.view-map" name="map" colSpan="12"/>
            <panel>
                <button name="mapBtn" title="View map" icon="fa-map-marker"
                        onClick="action-erp-building-address-method-view-map" colSpan="4"/>
            </panel>
        </panel>
        <panel sidebar="true" showIf="id != null">
            <field name="name" title="Name of the RC"/>
            <field name="$allApartments" title="All Apartments" type="integer" />
            <field name="$allResidents" title="All Residents" type="integer"/>
            <field name="$numberOfDebtors" title="Number of debtors" type="integer" />
            <field name="$totalAmountOfDebt" title="Total amount of debt" type="integer" />
        </panel>
    </form>

    <action-method name="action-building-apply-selected-geo">
        <call class="com.axelor.web.BuildingController" method="applySelectedGeoFromEditor"/>
    </action-method>

    <action-method name="action-building-apply-pending-geo">
        <call class="com.axelor.web.BuildingController" method="applyPendingGeo"/>
    </action-method>

    <action-view name="action-erp-building.view-map" title="Map">
        <view type="html" name="map/oneMarker.html?x={{ latitude }}&amp;y={{ longitude }}&amp;z=17"/>
    </action-view>

    <action-method name="action-building-method-address">
        <call class="com.axelor.web.BuildingController" method="geocodeAddress"/>
    </action-method>

    <action-method name="action-erp-building-address-method-view-map">
        <call class="com.axelor.web.BuildingController" method="viewMap"/>
    </action-method>

    <action-attrs name="action-building-attrs" model="com.axelor.apps.erp.db.Building">
        <attribute for="map" name="refresh" expr="true"/>
    </action-attrs>

    <action-method name="action-building-statistics">
        <call class="com.axelor.web.BuildingController" method="buildingStatistics"/>
    </action-method>

</object-views>