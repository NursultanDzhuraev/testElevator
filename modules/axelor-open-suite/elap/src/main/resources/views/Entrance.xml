<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

    <grid name="entrance-grid" title="Access zones" model="com.axelor.apps.erp.db.Entrance">
        <field name="name"/>
        <field name="entranceNumber" title="Zone code"/>
        <field name="externalId"/>
        <field name="building" target-name="name" title="Residential complex"/>
        <field name="parentZone" target-name="name"/>
        <field name="version"/>
    </grid>

    <grid name="entrance-apartment-grid" title="Access zones" model="com.axelor.apps.erp.db.Entrance">
        <field name="name"/>
        <field name="entranceNumber"/>
        <field name="building" target-name="name"/>
    </grid>

    <form name="entrance-form" title="Access zone" model="com.axelor.apps.erp.db.Entrance">
        <panel>
            <field name="name"/>
            <field name="entranceNumber"/>
            <field name="externalId"/>
            <field name="building"/>
            <field name="parentZone"/>
            <field name="version"/>
            <field name="updatedAt"/>
        </panel>
        <panel-related field="device" title="Devices">
            <field name="name"/>
            <field name="deviceType"/>
            <field name="status"/>
        </panel-related>
    </form>

</object-views>
