<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

    <grid name="device-grid" title="Devices" model="com.axelor.apps.erp.db.Device">
        <field name="name"/>
        <field name="externalId"/>
        <field name="deviceType"/>
        <field name="status"/>
        <field name="controller" target-name="name"/>
        <field name="deviceGroup" target-name="name"/>
        <field name="entrance" target-name="name"/>
    </grid>

    <form name="device-form" title="Device" model="com.axelor.apps.erp.db.Device">
        <panel>
            <field name="name"/>
            <field name="externalId"/>
            <field name="uuid" readonly="true"/>
            <field name="deviceType"/>
            <field name="status"/>
            <field name="controller"/>
            <field name="deviceGroup"/>
            <field name="building"/>
            <field name="entrance"/>
            <field name="ip"/>
            <field name="login"/>
            <field name="password"/>
            <field name="host"/>
            <field name="protocol"/>
            <field name="port"/>
            <field name="version"/>
            <field name="updatedAt"/>
            <button name="saveAndUpdateDevice" title="Sync device" onClick="action-device-save-update"/>
        </panel>
    </form>

    <action-method name="action-device-save-update">
        <call class="com.axelor.web.DeviceController" method="saveAndUpdateDevice"/>
    </action-method>

</object-views>
