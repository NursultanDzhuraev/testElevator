<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

    <grid name="access-rights-resident-grid" title="Credentials" model="com.axelor.apps.erp.db.AccessRights">
        <field name="permissionName" title="Credential name"/>
        <field name="permissionType" title="Credential type"/>
        <field name="credentialStatus"/>
        <field name="isTemporary"/>
        <field name="validForm"/>
        <field name="validUntil"/>
    </grid>

    <form name="access-rights-resident-form" title="Credential" model="com.axelor.apps.erp.db.AccessRights">
        <panel>
            <field name="permissionName" required="true"/>
            <field name="permissionType"/>
            <field name="externalId"/>
            <field name="credentialStatus"/>
            <field name="isTemporary"/>
            <field name="validForm"/>
            <field name="validUntil"/>
            <field name="dataJson" widget="html"/>
            <field name="version"/>
            <field name="updatedAt"/>
            <button name="saveAccessRights" title="Sync credential" onClick="action-access-rights-save-update"/>
        </panel>
    </form>

    <action-method name="action-access-rights-save-update">
        <call class="com.axelor.web.AccessRightsController" method="accessRightsSave"/>
    </action-method>

</object-views>
