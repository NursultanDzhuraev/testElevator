<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.2.xsd">

    <module name="erp" package="com.axelor.apps.erp.db"/>

    <entity name="Entrance">
        <string name="entranceNumber" title="Zone code" required="true"/>
        <string name="externalId" unique="true" index="true"/>
        <string name="name" title="Access zone"/>
        <many-to-one name="parentZone" ref="com.axelor.apps.erp.db.Entrance"/>
        <integer name="version" default="1"/>
        <datetime name="updatedAt" tz="true"/>

        <many-to-one name="building" ref="com.axelor.apps.erp.db.Building"/>
        <one-to-many name="apartment" ref="com.axelor.apps.erp.db.Apartment"
                     mappedBy="entrance"/>
        <one-to-many name="device" ref="com.axelor.apps.erp.db.Device" mappedBy="entrance"/>

        <unique-constraint columns="building,entranceNumber"/>
    </entity>
</domain-models>
