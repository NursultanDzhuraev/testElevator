<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.2.xsd">

    <module name="erp" package="com.axelor.apps.erp.db"/>

    <entity name="AccessRights">
        <string name="uuid" unique="true" index="true" nullable="false"/>
        <string name="permissionName" title="Permission Name" nullable="false"/>
        <string name="permissionType" title="Permission Type" selection="permission.type.select"
                default="custom_access"/>
        <datetime name="validForm" tz="true" title="Valid Form"/>
        <datetime name="validUntil" tz="true" title="Valid Until"/>
        <one-to-many name="accessCredentials"
                     ref="com.axelor.apps.erp.db.AccessCredential" mappedBy="accessRights"
                     title="Access Credentials"/>

        <finder-method name="findByUUID" using="uuid"/>
        <finder-method name="findByType" using="permissionType"/>

        <entity-listener class="com.axelor.entity.listener.AccessRightsListener"/>
    </entity>
</domain-models>