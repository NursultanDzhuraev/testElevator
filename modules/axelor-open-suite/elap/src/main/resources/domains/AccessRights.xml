<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.2.xsd">

    <module name="erp" package="com.axelor.apps.erp.db"/>

    <entity name="AccessRights">
        <string name="uuid" unique="true" index="true" nullable="false"/>
        <string name="externalId" index="true"/>
        <string name="permissionName" title="Credential name" nullable="false"/>
        <string name="permissionType" title="Credential type" selection="credential.type.select"
                default="card"/>
        <boolean name="isTemporary" default="false"/>
        <string name="credentialStatus" selection="credential.status.select" default="active"/>
        <string name="dataJson" large="true" title="Data (JSON)"/>
        <datetime name="validForm" tz="true" title="Valid From"/>
        <datetime name="validUntil" tz="true" title="Valid To"/>
        <integer name="version" default="1"/>
        <datetime name="updatedAt" tz="true"/>
        <one-to-many name="accessCredentials"
                     ref="com.axelor.apps.erp.db.AccessCredential" mappedBy="accessRights"
                     title="Person access"/>

        <finder-method name="findByUUID" using="uuid"/>
        <finder-method name="findByType" using="permissionType"/>

        <entity-listener class="com.axelor.entity.listener.AccessRightsListener"/>
    </entity>
</domain-models>
