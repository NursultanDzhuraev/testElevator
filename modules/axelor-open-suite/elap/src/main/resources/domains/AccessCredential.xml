<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
               http://axelor.com/xml/ns/domain-models/domain-models_7.1.xsd">

  <module name="erp" package="com.axelor.apps.erp.db"/>

  <entity name="AccessCredential">
    <many-to-one name="partner" ref="com.axelor.apps.base.db.Partner"/>
    <many-to-one name="device" ref="com.axelor.apps.erp.db.Device" required="true"/>
    <many-to-one name="accessRights" ref="com.axelor.apps.erp.db.AccessRights" required="true"/>
    <many-to-one name="accessZone" ref="com.axelor.apps.erp.db.Entrance"/>
    <datetime name="validFrom" tz="true"/>
    <datetime name="validTo" tz="true"/>
    <integer name="version" default="1"/>
    <datetime name="updatedAt" tz="true"/>
  </entity>

</domain-models>
